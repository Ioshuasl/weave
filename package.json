{
  "name": "weave-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "weave",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "build": "npm run build -w demo",
    "preview": "npm run preview -w demo",
    "clean": "npm run clean -w demo",
    "lint": "npm run typecheck -w weave && npm run typecheck -w demo && npm run depcruise",
    "depcruise": "depcruise weave/src demo/src --config .dependency-cruiser.cjs",
    "cy:open": "npm run cy:open -w demo",
    "cy:run": "npm run cy:run -w demo",
    "test:e2e": "npm run test:e2e -w demo"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "typescript": "~5.8.2"
  }
}
